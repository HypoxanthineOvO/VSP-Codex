{"id":4,"iid":1,"project_id":93,"title":"Fix VSP archive installer staging move","description":"## Summary\n- avoid clobbering the package install target directory from write_vsp_release_metadata under POSIX sh\n- skip appending duplicate vspRelease metadata when the archive already contains it\n\n## Root Cause\nwrite_vsp_release_metadata reused the global release_dir variable. Under /bin/sh this overwrote install_package_release's target release_dir with the staging directory, so the subsequent cleanup removed the staging directory before mv.\n\n## Validation\n- sh -n scripts/install/install.sh\n- git diff --check\n- isolated HOME/CODEX_HOME/CODEX_INSTALL_DIR install of v0.134.0-vsp.7-preview succeeded\n- vsp-codex --version -\u003e vsp-codex 0.134.0-vsp.7\n- codex-package.json vspRelease count == 1","state":"opened","created_at":"2026-06-05T10:50:00.272Z","updated_at":"2026-06-05T10:50:01.588Z","merged_by":null,"merge_user":null,"merged_at":null,"closed_by":null,"closed_at":null,"target_branch":"main","source_branch":"fix/install-archive-metadata-dir","user_notes_count":0,"upvotes":0,"downvotes":0,"author":{"id":2,"username":"lichf","public_email":"","name":"李超凡","state":"active","locked":false,"avatar_url":"https://gitlab.vsplab.cn/uploads/-/system/user/avatar/2/avatar.png","web_url":"https://gitlab.vsplab.cn/lichf"},"assignees":[],"assignee":null,"reviewers":[],"source_project_id":93,"target_project_id":93,"labels":[],"draft":false,"imported":false,"imported_from":"none","work_in_progress":false,"milestone":null,"merge_when_pipeline_succeeds":false,"merge_status":"checking","detailed_merge_status":"checking","merge_after":null,"sha":"fc36c272fd09e8a4285f25338f04e48e0c83f144","merge_commit_sha":null,"squash_commit_sha":null,"discussion_locked":null,"should_remove_source_branch":null,"force_remove_source_branch":true,"prepared_at":"2026-06-05T10:50:01.577Z","reference":"!1","references":{"short":"!1","relative":"!1","full":"heyx/Codex!1"},"web_url":"https://gitlab