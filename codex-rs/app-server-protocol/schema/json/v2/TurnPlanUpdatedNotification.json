{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TurnPlanNode": {
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/TurnPlanStepStatus"
        },
        "subplan": {
          "anyOf": [
            {
              "$ref": "#/definitions/TurnSubPlan"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "title"
      ],
      "type": "object"
    },
    "TurnPlanState": {
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "items": {
            "$ref": "#/definitions/TurnPlanNode"
          },
          "type": "array"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    },
    "TurnPlanStep": {
      "properties": {
        "status": {
          "$ref": "#/definitions/TurnPlanStepStatus"
        },
        "step": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "step"
      ],
      "type": "object"
    },
    "TurnPlanStepStatus": {
      "enum": [
        "pending",
        "inProgress",
        "completed"
      ],
      "type": "string"
    },
    "TurnPlanSubItem": {
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/TurnPlanStepStatus"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "title"
      ],
      "type": "object"
    },
    "TurnSubPlan": {
      "properties": {
        "items": {
          "items": {
            "$ref": "#/definitions/TurnPlanSubItem"
          },
          "type": "array"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items"
      ],
      "type": "object"
    }
  },
  "properties": {
    "explanation": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan": {
      "items": {
        "$ref": "#/definitions/TurnPlanStep"
      },
      "type": "array"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "plan",
    "threadId",
    "turnId"
  ],
  "title": "TurnPlanUpdatedNotification",
  "type": "object"
}