{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ToolRequestUserInputOption": {
      "description": "Defines a single selectable option for request_user_input.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "label"
      ],
      "type": "object"
    },
    "ToolRequestUserInputQuestion": {
      "description": "Represents one request_user_input question and its required options.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "grantsApproval": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "header": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "intentOnly": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "isOther": {
          "default": false,
          "type": "boolean"
        },
        "isSecret": {
          "default": false,
          "type": "boolean"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/ToolRequestUserInputQuestionKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "items": {
            "$ref": "#/definitions/ToolRequestUserInputOption"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "question": {
          "type": "string"
        },
        "workflowDecisionType": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "header",
        "id",
        "question"
      ],
      "type": "object"
    },
    "ToolRequestUserInputQuestionKind": {
      "description": "Declares how a request_user_input question should be answered.",
      "enum": [
        "singleChoice",
        "multiChoice",
        "freeText",
        "ranking"
      ],
      "type": "string"
    }
  },
  "description": "Params sent with a request_user_input event.",
  "properties": {
    "autoResolutionMs": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "itemId": {
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/definitions/ToolRequestUserInputQuestion"
      },
      "type": "array"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "itemId",
    "questions",
    "threadId",
    "turnId"
  ],
  "title": "ToolRequestUserInputParams",
  "type": "object"
}